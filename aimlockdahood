local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local camera = workspace.CurrentCamera
local lp = Players.LocalPlayer

local sg = Instance.new("ScreenGui", lp:WaitForChild("PlayerGui"))
sg.ResetOnSpawn = false

local frame = Instance.new("Frame", sg)
frame.Size = UDim2.new(0, 200, 0, 70)
frame.Position = UDim2.new(0, 10, 0, 80)
frame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
frame.Active = true
frame.Draggable = true

local function createBtn(parent, y, txt)
    local b = Instance.new("TextButton", parent)
    b.Size = UDim2.new(0, 180, 0, 40)
    b.Position = UDim2.new(0, 10, 0, y)
    b.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    b.TextColor3 = Color3.new(1,1,1)
    b.Font = Enum.Font.SourceSansBold
    b.TextSize = 18
    b.Text = txt
    b.AutoButtonColor = false
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
    return b
end

local tb = createBtn(frame, 15, "Aimlock: OFF (T)")
local enabled = false
local target = nil

local FOV = 150
local SMOOTH = 0.5
local PRED = 0.03

local JUMP_OFFSET = 0.04 
local FALL_OFFSET = -0.03 

local velocityCalculators = {}

local function calculateVelocity(hrp)
    local lastPosition = hrp.Position
    local lastTime = tick()
    
    return function()
        local currentPosition = hrp.Position
        local currentTime = tick()
        local deltaTime = currentTime - lastTime
        
        if deltaTime > 0 then
            local vel = (currentPosition - lastPosition) / deltaTime
            lastPosition = currentPosition
            lastTime = currentTime
            return vel
        end
        return Vector3.new()
    end
end

local function getResolvedVelocity(player)
    local char = player.Character
    if not char then return Vector3.new() end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return Vector3.new() end
    
    if not velocityCalculators[player] then
        velocityCalculators[player] = calculateVelocity(hrp)
    end
    
    return velocityCalculators[player]()
end

local function valid(plr)
    return plr ~= lp
end

local function getPart(char)
    return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
end

local function getTarget()
    if target and target.Character then
        local h = target.Character:FindFirstChild("Humanoid")
        if h and h.Health > 0 and valid(target) then
            local p = getPart(target.Character)
            if p then
                local sp, os = camera:WorldToViewportPoint(p.Position)
                if os then
                    local cen = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
                    if (Vector2.new(sp.X, sp.Y) - cen).Magnitude <= FOV then
                        return target
                    end
                end
            end
        end
    end

    local closest, md = nil, math.huge
    local cen = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)

    for _, p in Players:GetPlayers() do
        if valid(p) and p.Character then
            local h = p.Character:FindFirstChild("Humanoid")
            if h and h.Health > 0 then
                local pt = getPart(p.Character)
                if pt then
                    local sp, os = camera:WorldToViewportPoint(pt.Position)
                    if os then
                        local d = (Vector2.new(sp.X, sp.Y) - cen).Magnitude
                        if d < md and d <= FOV then
                            md = d
                            closest = p
                        end
                    end
                end
            end
        end
    end
    return closest
end

local function toggle(state)
    enabled = state
    tb.Text = state and "Aimlock: ON (T)" or "Aimlock: OFF (T)"
    TweenService:Create(tb, TweenInfo.new(0.15), {BackgroundColor3 = state and Color3.fromRGB(60,130,60) or Color3.fromRGB(30,30,30)}):Play()
    if not state then target = nil end
end

tb.MouseButton1Click:Connect(function() toggle(not enabled) end)

UserInputService.InputBegan:Connect(function(i, gpe)
    if gpe then return end
    if i.KeyCode == Enum.KeyCode.T then toggle(not enabled) end
end)

RunService.RenderStepped:Connect(function()
    if not enabled then return end
    if not target then target = getTarget() end

    if target then
        local char = target.Character
        if char then
            local h = char:FindFirstChild("Humanoid")
            if h and h.Health > 0 then
                local part = getPart(char)
                if part then
                    local vel = getResolvedVelocity(target)
                    

                    local offsetPred = PRED
                    if vel.Y > 15 then
                        offsetPred = PRED + JUMP_OFFSET
                    elseif vel.Y < -10 then
                        offsetPred = PRED + FALL_OFFSET
                    end
                    
                    local predPos = part.Position + (vel * offsetPred)
                    
                    local tc = CFrame.new(camera.CFrame.Position, predPos)
                    camera.CFrame = camera.CFrame:Lerp(tc, SMOOTH)
                end
            else
                target = nil
            end
        else
            target = nil
        end
    end
end)

Players.PlayerRemoving:Connect(function(plr)
    velocityCalculators[plr] = nil
end)
